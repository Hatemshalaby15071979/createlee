# Copy to .env (or export these) to enable optional integrations.
# Createlee works fully WITHOUT any of these. Core generation is deterministic.

# --- Local Ollama (auto-detected at localhost:11434) -----------------------
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:8b          # empty = use first downloaded model
# OLLAMA_TIMEOUT=90

# --- Optional OpenAI-compatible cloud endpoint (free tier of your choice) --
# CREATELEE_CLOUD_LLM_URL=https://api.example.com/v1/chat/completions
# CREATELEE_CLOUD_LLM_KEY=sk-...
# CREATELEE_CLOUD_LLM_MODEL=model-name

# --- Personal email (SMTP). Without these -> portable .eml draft -----------
# Createlee never knows or stores your mailbox password elsewhere.
# CREATELEE_SMTP_HOST=smtp.gmail.com
# CREATELEE_SMTP_PORT=587
# CREATELEE_SMTP_SECURITY=starttls     # starttls | ssl | none
# CREATELEE_SMTP_USER=you@yourdomain.com
# CREATELEE_SMTP_PASSWORD=your-app-password
# CREATELEE_SMTP_FROM=you@yourdomain.com

# --- Misc -------------------------------------------------------------------
# CREATELEE_PORT=7860
# CREATELEE_WEB_ENRICH=1
# CREATELEE_MAX_UPLOAD_MB=25
# CREATELEE_OUTPUT_DIR=/workspace/createlee/outputs
# CREATELEE_EVIDENCE_DIR=/workspace/createlee/evidence_pack
# CREATELEE_LIBRARY_DIR=/workspace/createlee/system_library
# CREATELEE_SECRET_KEY=change-this-to-a-random-string
