# CreateLee — do not commit secrets, caches, or runtime output

# Secrets / configuration
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.venv/
venv/

# Virtualenv dir created by setup-miniconda / pip
createlee/

# Runtime output — never commit generated documents or sessions
outputs/
sessions/
evidence/
verification/*.json
verification/*.md

# OS noise
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Synthetic upload fixtures — export-shaped rehearsal CSVs, never client data.
# They must not be committed: the validator runs against golden_examples, and
# these folders only ever hold local test uploads.
**/system_library/uploaded/
uploads/
Createlee_system_library/uploaded/
